# Postgres (Supabase). DIRECT_URL is the non-pooled connection Prisma migrate needs.
# connect_timeout/pool_timeout are widened past Prisma's 10s default because
# connection establishment over the pooler can take several seconds on some
# networks — without this, moments of concurrent requests can time out
# waiting for a free connection even though the DB itself is healthy.
DATABASE_URL="postgresql://user:password@host:5432/db?pgbouncer=true&connect_timeout=30&pool_timeout=30"
DIRECT_URL="postgresql://user:password@host:5432/db"

# Supabase storage
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_KEY="sb_secret_..."

# Stripe
STRIPE_SECRET_KEY="sk_live_or_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_or_test_..."

# Outbound mail for printer job + customer confirmation emails (Gmail app password)
EMAIL_USER="you@gmail.com"
EMAIL_APP_PASSWORD="app-specific-password"

# Owner login sessions — generate with: openssl rand -base64 32
JWT_SECRET="change-me"

# Authorizes /api/internal/retry-failed-jobs. On Vercel, set this as a project
# env var and Vercel Cron will automatically send it as "Authorization: Bearer <value>".
CRON_SECRET="change-me"

# Optional: overrides the auto-detected origin used to build QR code URLs.
# Needed if the app runs behind a proxy that doesn't set forwarded headers.
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
